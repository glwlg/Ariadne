<Window x:Class="Ariadne.iPhoneControl.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ariadne · iPhone 控制" Width="450" Height="680" MinWidth="390" MinHeight="600"
        Background="#F5F6F8" FontFamily="Microsoft YaHei UI" FontSize="14"
        Closing="OnClosing" Deactivated="OnDeactivated"
        PreviewKeyDown="OnKeyDown" SourceInitialized="OnSourceInitialized">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="iPhone 控制" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="关闭此窗口后仍可直接操作投屏画面。" Foreground="#555B66" Margin="0,0,0,12"/>
      <TextBlock x:Name="StatusText" Text="正在启动蓝牙控制…" Margin="0,0,0,10" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="SetupText" Margin="0,0,0,14" Foreground="#555B66" TextWrapping="Wrap"/>
      <TextBlock Text="控制设备" Margin="0,0,0,4"/>
      <ComboBox x:Name="Devices" MinHeight="34" DisplayMemberPath="Display"
                SelectionChanged="OnDeviceChanged" Margin="0,0,0,12"/>
      <TextBlock Text="直接操作：在投屏画面点击或按住拖动；滚轮切换视频，按住可长按。右键菜单可关闭直接操作，Alt+Enter 切换全屏。"
                 Foreground="#555B66" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <StackPanel x:Name="InputPanel" IsEnabled="False">
        <Border x:Name="Touchpad" Height="190" Background="White" BorderBrush="#CDD2DB"
                BorderThickness="1" CornerRadius="10" Focusable="True"
                AutomationProperties.Name="手机触控板"
                MouseMove="OnPointerMove" MouseEnter="OnPointerEnter" MouseLeave="OnPointerLeave"
                MouseLeftButtonDown="OnPointerDown" MouseLeftButtonUp="OnPointerUp"
                LostMouseCapture="OnLostCapture" MouseWheel="OnWheel">
          <StackPanel VerticalAlignment="Center" IsHitTestVisible="False" Margin="16">
            <TextBlock Text="触控板" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="移动指针 · 点击 · 按住拖动" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#555B66"/>
            <TextBlock Text="滚轮 / ↑↓ 切换视频 · Esc 松开" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="#555B66"/>
          </StackPanel>
        </Border>
        <WrapPanel Margin="0,12,0,0">
          <Button Content="↑ 上滑" Click="OnSwipeUp"/>
          <Button Content="↓ 下滑" Click="OnSwipeDown"/>
          <Button Content="点击" Click="OnClick"/>
          <Button Content="按住长按" PreviewMouseLeftButtonDown="OnHoldDown"
                  PreviewMouseLeftButtonUp="OnHoldUp" LostMouseCapture="OnLostCapture"/>
        </WrapPanel>
        <TextBlock Text="滑动前，把手机指针移到视频中部。" Foreground="#555B66" Margin="0,0,0,8"/>
        <DockPanel>
          <TextBlock Text="滑动距离" VerticalAlignment="Center"/>
          <Slider x:Name="SwipeDistance" Minimum="120" Maximum="600" Value="300"
                  TickFrequency="30" IsSnapToTickEnabled="True" Margin="12,0,0,0"
                  AutomationProperties.Name="滑动距离"/>
        </DockPanel>
        <TextBlock Text="倍速：点击手机应用里的倍速菜单选择；支持长按加速的视频可按住「按住长按」。" TextWrapping="Wrap"
                   Foreground="#555B66" Margin="0,12,0,12"/>
      </StackPanel>
      <WrapPanel>
        <Button Content="Windows 蓝牙设置" Click="OnBluetoothSettings"/>
        <Button Content="停止控制" Click="OnStopControl"/>
        <CheckBox Content="置顶" VerticalAlignment="Center" Margin="4,0,0,8"
                  Checked="OnTopmostChanged" Unchecked="OnTopmostChanged"/>
      </WrapPanel>
      <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
  </ScrollViewer>
</Window>
